# Copy to /etc/darkroom-deploy.env on the NUC: owned by root, mode 600. Never commit the real one.
# systemd reads this file, so the deploy user cannot read the Telegram token from disk.

# From @BotFather, and your chat id (see the README for how to find it).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public health URL, checked from the NUC through Cloudflare (catches a broken tunnel).
DEPLOY_HEALTH_URL=https://film.jamielab.uk/api/health

# Must match the project name of the running stack (`docker compose ls`) so the database
# volume (<project>_dbdata) is reused. A different name would start an empty database.
COMPOSE_PROJECT_NAME=darkroom

# Optional overrides (defaults shown):
# DEPLOY_REPO=jsmithedin/darkroom
# DEPLOY_BRANCH=main
# DEPLOY_CHECKOUT=/opt/darkroom/repo
# DEPLOY_ENV_FILE=/opt/darkroom/.env
# REQUIRED_CHECKS=backend,frontend,image,skills
# REQUIRE_VERIFIED=1
# HEALTH_WAIT_SECONDS=90
# FAILURES_BEFORE_ALERT=2
# REPEAT_ALERT_SECONDS=21600
