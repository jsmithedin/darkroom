# Copy to .env and fill in. Never commit .env.

# Public URL of the app (OAuth redirects, MCP metadata and Host checks are built from this).
PUBLIC_BASE_URL=https://film.jamielab.uk

# Postgres. The app's DATABASE_URL is assembled from these in compose.yaml.
POSTGRES_PASSWORD=change-me

# JSON list of emails allowed to sign in.
ALLOWED_EMAILS=["you@example.com"]

# Random string, e.g. `openssl rand -hex 32`.
SESSION_SECRET=change-me

# Google OAuth client (Phase 1).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Name of the existing docker network that cloudflared is attached to.
CLOUDFLARED_NETWORK=cloudflared

# Only trust X-Forwarded-* from the tunnel network. Set to cloudflared's subnet or IP.
FORWARDED_ALLOW_IPS=172.18.0.0/16
